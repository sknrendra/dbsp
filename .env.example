# Copy to .env and adjust. .env itself is gitignored.

MSSQL_SA_PASSWORD=YourPassword

# MSSQL_PORT sets the host-side port docker-compose.yml publishes mssql on
# (container's internal port always stays 1433). MSSQL_HOST is only needed
# by scripts/load_excel_data.py when connecting from somewhere other than
# this host.
MSSQL_HOST=localhost
MSSQL_PORT=1433
